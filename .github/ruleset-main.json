{
  "name": "main: PR and deterministic CI",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge", "squash", "rebase"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "Classify PR changes", "integration_id": 15368},
          {"context": "Analyze and Test", "integration_id": 15368},
          {"context": "Android Integration", "integration_id": 15368},
          {"context": "Android APK", "integration_id": 15368},
          {"context": "iOS Integration", "integration_id": 15368},
          {"context": "iOS Simulator", "integration_id": 15368},
          {"context": "Documentation Consistency", "integration_id": 15368}
        ]
      }
    }
  ]
}
